---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, getProduct, money } from '../../data/catalog';
import { business, SITE_URL } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const p = getProduct(handle!)!;
const thumb = await getImage({ src: p.bag, width: 160, format: 'webp' });
const ogImg = await getImage({ src: p.bag, width: 1200, format: 'jpg' });
const related = products.filter((x) => x.handle !== p.handle);
const firstAvail = p.variants.find((v) => v.available) ?? p.variants[0];
const url = `${SITE_URL}/products/${p.handle}`;
const originLine = p.origin === 'Espresso' ? 'Espresso blend' : `${p.origin}${p.region ? ' · ' + p.region : ''}`;

const specs = [
  ['Origin', p.origin === 'Espresso' ? 'Blend' : p.origin === 'Colombia' && p.region === 'Decaf' ? 'Colombia' : `${p.origin}, ${p.region}`],
  p.varietal && ['Varietal', p.varietal],
  p.process && ['Process', p.process],
  p.roast && ['Roast', p.roast],
  p.grind && ['Grind', p.grind],
  ['Sizes', p.variants.map((v) => v.title).join(' · ')],
].filter(Boolean) as [string, string][];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.title,
    description: `${p.title} — small-batch coffee roasted in Southern Indiana by Kølkin Coffee. ${p.summary}`,
    image: [new URL(ogImg.src, SITE_URL).href],
    brand: { '@type': 'Brand', name: 'Kølkin Coffee' },
    category: 'Coffee',
    url,
    additionalProperty: specs.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
    offers: p.variants.map((v) => ({
      '@type': 'Offer',
      name: `${p.title} — ${v.title}`,
      sku: String(v.id),
      price: v.price.toFixed(2),
      priceCurrency: 'USD',
      availability: v.available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: `${url}?variant=${v.id}`,
      seller: { '@type': 'Organization', name: 'Kølkin Coffee' },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Coffee', item: `${SITE_URL}/collections/coffee` },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
];
---
<Base
  title={`${p.title} — Whole Bean Coffee | Kølkin Coffee`}
  description={`${p.title}, fresh roasted in small batches in Southern Indiana. ${p.summary} From ${money(p.priceFrom)}.`}
  image={ogImg.src}
  type="product"
  jsonld={jsonld}
>
  <article class="pdp" style={`--tint:${p.tint}; --accent:${p.accent}; --accent-ink:${p.accentInk}`}>
    <div class="wrap pdp-grid">
      <nav class="crumbs label label--muted" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/collections/coffee">Coffee</a></li>
          <li aria-current="page">{p.origin}{p.origin !== 'Espresso' ? ` ${p.region}` : ' Blend'}</li>
        </ol>
      </nav>

      <div class="gallery">
        <figure class="g-main">
          <span class="g-word" aria-hidden="true" data-word={p.origin}></span>
          <Image src={p.bag} alt={`${p.title} — 12oz whole bean bag with the Kølkin river label`} widths={[300, 480, 720]} sizes="(min-width: 1000px) 360px, 46vw" loading="eager" fetchpriority="high" class="g-bag" />
        </figure>
        {p.label && (
          <figure class="g-label">
            <div class="media" data-reveal="mask">
              <Image src={p.label} alt={`Close-up of the ${p.title} bag label listing ${p.notes.join(', ')}`} widths={[480, 820]} sizes="(min-width: 1000px) 50vw, 92vw" loading="lazy" />
            </div>
            <figcaption class="label label--muted">The label — illustrated with the river, the kayakers and the mountain that gave us our name.</figcaption>
          </figure>
        )}
      </div>

      <div class="buy">
        <div class="buy-inner">
          <p class="label eyebrow">{originLine}</p>
          <h1 class="h1 buy-title">{p.title}</h1>
          <p class="buy-price num" data-price aria-live="polite">{money(firstAvail.price)}</p>

          <ul class="notes" aria-label="Tasting notes">
            {p.notes.map((n) => <li>{n}</li>)}
          </ul>
          <p class="body-copy">{p.summary}</p>

          <form class="buy-form" data-buy
            data-product={JSON.stringify({ handle: p.handle, title: p.title, image: thumb.src })}>
            <fieldset class="sizes">
              <legend class="label">Bag size</legend>
              <div class="size-opts">
                {p.variants.map((v) => (
                  <label class={`size ${!v.available ? 'is-out' : ''}`}>
                    <input type="radio" name="variant" value={v.id} data-price={v.price} data-title={v.title} checked={v.id === firstAvail.id} disabled={!v.available} />
                    <span class="size-name">{v.title}</span>
                    <span class="size-price num">{v.available ? money(v.price) : 'Sold out'}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="buy-row">
              <div class="stepper" role="group" aria-label="Quantity">
                <button type="button" data-step="-1" aria-label="Decrease quantity">−</button>
                <label class="sr-only" for="qty">Quantity</label>
                <input id="qty" name="qty" type="number" inputmode="numeric" min="1" max="99" value="1" class="num" />
                <button type="button" data-step="1" aria-label="Increase quantity">+</button>
              </div>
              <button type="submit" class="btn add-btn" disabled={!p.available}>
                <span data-add-label>{p.available ? 'Add to bag' : 'Sold out'}</span>
                <span class="add-total num" data-total>{money(firstAvail.price)}</span>
              </button>
            </div>
            <p class="buy-status" role="status" data-status></p>
          </form>

          <ul class="assure">
            <li><span class="label">Free shipping</span> on orders over ${business.freeShippingThreshold}</li>
            <li><span class="label">Subscribe &amp; save 10%</span> — <a class="text-link" href={p.shopifyUrl}>set up a subscription on our Shopify store</a></li>
            <li><span class="label">Whole bean</span> — grind just before you brew</li>
          </ul>

          <dl class="specs">
            {specs.map(([k, v]) => <div><dt class="label label--muted">{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </article>

  <section class="story section on-dark" aria-labelledby="story-t">
    <div class="wrap story-grid">
      <p class="label eyebrow">Roasted in Southern Indiana</p>
      <h2 id="story-t" class="display">A small batch, <em>a slower current.</em></h2>
      <div class="body-copy">
        <p>Every Kølkin coffee is roasted in small batches to keep it fresh and consistent — the same coffee we pour for neighbors at our shop on Charlestown Road in New Albany.</p>
        <p>We source with intention, working directly with growers and trusted importers to bring you coffees that are traceable, consistent, and exceptional in the cup.</p>
      </div>
      <a href="/our-story" class="link">Our story <Arrow /></a>
    </div>
  </section>

  <section class="related section" aria-labelledby="rel-t">
    <div class="wrap">
      <header class="rel-head">
        <h2 id="rel-t" class="h2">Keep <em>exploring.</em></h2>
        <a href="/collections/coffee" class="link">All coffee <Arrow /></a>
      </header>
      <ul class="rel-grid" role="list">
        {related.map((r) => <li><ProductCard product={r} compact /></li>)}
      </ul>
    </div>
  </section>

  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <span class="sb-title">{p.origin}{p.origin === 'Espresso' ? ' Blend' : ''}</span>
    <span class="sb-price num" data-sb-price>{money(firstAvail.price)}</span>
    <button type="button" class="btn" data-sb-add tabindex="-1">Add to bag</button>
  </div>
</Base>

<script>
  import { bag, money } from '../../scripts/bag';
  const form = document.querySelector<HTMLFormElement>('[data-buy]');
  if (form) {
    const meta = JSON.parse(form.dataset.product!);
    const qty = form.querySelector<HTMLInputElement>('#qty')!;
    const priceEl = document.querySelector('[data-price]')!;
    const totalEl = form.querySelector('[data-total]')!;
    const status = form.querySelector('[data-status]')!;
    const sbPrice = document.querySelector('[data-sb-price]');
    const selected = () => form.querySelector<HTMLInputElement>('input[name="variant"]:checked');
    const clampQty = () => { const n = Math.max(1, Math.min(99, Math.round(Number(qty.value) || 1))); qty.value = String(n); return n; };
    const update = () => {
      const v = selected(); if (!v) return;
      const price = Number(v.dataset.price);
      priceEl.textContent = money(price).replace('.00', '');
      totalEl.textContent = money(price * clampQty());
      if (sbPrice) sbPrice.textContent = money(price).replace('.00', '');
    };
    form.addEventListener('change', update);
    qty.addEventListener('input', () => { if (qty.value !== '') update(); });
    qty.addEventListener('blur', update);
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { qty.value = String(clampQty() + Number(b.dataset.step)); update(); }));
    // Deep-link support for ?variant=ID (matches Shopify URLs)
    const want = new URLSearchParams(location.search).get('variant');
    if (want) { const r = form.querySelector<HTMLInputElement>(`input[value="${CSS.escape(want)}"]`); if (r && !r.disabled) r.checked = true; }
    update();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = selected(); if (!v) return;
      const n = clampQty();
      bag.add({ variantId: Number(v.value), handle: meta.handle, title: meta.title, variantTitle: v.dataset.title!, price: Number(v.dataset.price), image: meta.image }, n);
      status.textContent = `Added ${n} × ${meta.title}, ${v.dataset.title}, to your bag.`;
      document.dispatchEvent(new CustomEvent('bag:added'));
    });

    // Mobile sticky add bar appears once the main button scrolls away
    const sticky = document.querySelector<HTMLElement>('[data-sticky-buy]');
    const addBtn = form.querySelector('.add-btn');
    if (sticky && addBtn) {
      new IntersectionObserver(([en]) => {
        const show = !en.isIntersecting && en.boundingClientRect.top < 0;
        sticky.classList.toggle('is-on', show);
        sticky.setAttribute('aria-hidden', String(!show));
        sticky.querySelector('button')!.tabIndex = show ? 0 : -1;
      }).observe(addBtn);
      sticky.querySelector('[data-sb-add]')!.addEventListener('click', () => form.requestSubmit());
    }
  }
</script>

<style>
  .pdp { padding-top: calc(var(--header-h) + 20px); background: var(--paper); }
  .pdp-grid { display: grid; gap: 28px; padding-bottom: clamp(64px, 9vw, 140px); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs li + li::before { content: '/'; margin-right: 6px; opacity: .5; }
  .crumbs a:hover { color: var(--copper); }
  .gallery { display: grid; gap: 16px; min-width: 0; }
  .g-main { position: relative; background: var(--tint); aspect-ratio: 4 / 5; display: grid; place-items: center; overflow: hidden; }
  .g-word::before { content: attr(data-word); }
  .g-word { position: absolute; top: 5%; left: 0; right: 0; text-align: center; font: italic 300 clamp(4rem, 15vw, 11rem)/1 var(--serif); letter-spacing: -.045em; color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .g-main :global(.g-bag) { position: absolute; left: 50%; bottom: 7%; translate: -50% 0; height: 76%; width: auto; max-width: none; filter: drop-shadow(0 40px 40px rgba(20,14,8,.3)); }
  .motion .g-main :global(.g-bag) { animation: bag-in 1.4s var(--ease) both .1s; }
  @keyframes bag-in { from { opacity: 0; transform: translateY(40px) rotate(-2deg); } }
  .g-label .media { aspect-ratio: 820 / 560; background: #fff; }
  .g-label figcaption { margin-top: 12px; max-width: 46ch; }

  .buy-inner { display: grid; gap: 22px; }
  .buy-title { font-size: clamp(2.3rem, 4.4vw, 4rem); }
  .buy-price { font: 340 clamp(1.6rem, 2.4vw, 2.1rem)/1 var(--serif); }
  .notes { display: flex; flex-wrap: wrap; gap: 8px; }
  .notes li { font: 560 .7rem/1 var(--sans); font-stretch: 118%; letter-spacing: .14em; text-transform: uppercase; padding: 10px 13px; background: var(--tint); }
  .buy-form { display: grid; gap: 20px; padding-top: 8px; }
  .sizes { border: 0; padding: 0; margin: 0; }
  .sizes legend { margin-bottom: 12px; padding: 0; }
  .size-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .size { position: relative; display: grid; gap: 4px; padding: 14px 14px 12px; border: 1px solid var(--line); cursor: pointer; transition: border-color .3s, background .3s; min-height: 64px; }
  .size input { position: absolute; opacity: 0; inset: 0; cursor: pointer; margin: 0; }
  .size-name { font: 400 1.2rem/1 var(--serif); }
  .size-price { font-size: .85rem; color: var(--ink-soft); }
  .size:hover { border-color: var(--ink); }
  .size:has(input:checked) { border-color: var(--ink); background: var(--ink); color: var(--cream); }
  .size:has(input:checked) .size-price { color: rgba(243,237,226,.75); }
  .size:has(input:focus-visible) { outline: 2px solid var(--copper); outline-offset: 2px; }
  .size.is-out { opacity: .45; cursor: not-allowed; }
  .buy-row { display: grid; grid-template-columns: auto 1fr; gap: 10px; }
  .stepper { display: flex; align-items: center; border: 1px solid var(--line); }
  .stepper button { width: 46px; height: 54px; font-size: 1.2rem; }
  .stepper button:hover { background: var(--cream); }
  .stepper input { width: 40px; text-align: center; border: 0; background: transparent; font-size: 1rem; appearance: textfield; -moz-appearance: textfield; }
  .stepper input::-webkit-inner-spin-button, .stepper input::-webkit-outer-spin-button { -webkit-appearance: none; }
  .add-btn { justify-content: space-between; min-height: 56px; }
  .add-total { font-stretch: 100%; letter-spacing: .04em; }
  .buy-status { font-size: var(--fs-small); color: var(--olive); min-height: 1.2em; }
  .assure { display: grid; gap: 10px; padding: 18px 0; border-block: 1px solid var(--line); font-size: .95rem; color: var(--ink-soft); }
  .assure .label { color: var(--ink); margin-right: 6px; }
  .specs { display: grid; }
  .specs div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .specs dd { font-size: .98rem; }

  @media (min-width: 1000px) {
    .pdp-grid { grid-template-columns: 7fr 5fr; column-gap: calc(var(--gutter) * 1.5); row-gap: 20px; }
    .crumbs { grid-column: 1 / -1; }
    .buy { position: relative; }
    .buy-inner { position: sticky; top: calc(var(--header-h) + 28px); }
    .g-main { aspect-ratio: auto; height: calc(100vh - var(--header-h) - 80px); min-height: 620px; max-height: 900px; }
  }

  .story { overflow: hidden; }
  .story-grid { display: grid; gap: 26px; justify-items: start; max-width: 980px; }
  .story .body-copy { color: rgba(243,237,226,.75); }

  .rel-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 40px; }
  .rel-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 14px; }
  @media (min-width: 1000px) { .rel-grid { grid-template-columns: repeat(4, 1fr); gap: var(--gutter); } }

  .sticky-buy {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; gap: 14px;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid var(--line);
    transform: translateY(110%); transition: transform .5s var(--ease);
  }
  .sticky-buy.is-on { transform: none; }
  .sb-title { font: 400 1.15rem/1 var(--serif); flex: 1; }
  .sb-price { font-size: .95rem; }
  .sticky-buy .btn { min-height: 46px; }
  @media (min-width: 1000px) { .sticky-buy { display: none; } }
</style>
