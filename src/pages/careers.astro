---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Arrow from '../components/Arrow.astro';
import { business } from '../data/site';
import orderHere from '../assets/photos/shop-order-here.jpg';

const roles = [
  { n: '01', t: 'Barista', d: 'A Barista’s primary responsibility is to make our coffee drinks according to the menu prescribed and maintain the quality that our customers expect.' },
  { n: '02', t: 'Community development', d: 'Our shopkeepers are trained to develop a community with walk-in and drive-through customers. We do not use an electronic headset in the drive-through. Conversation and politeness are expected from our employees in any circumstance when they enter our business.' },
  { n: '03', t: 'A clean, healthy shop', d: 'Our Barista / Shopkeepers are required to maintain a clean and healthy environment. We are accountable to both the state and our customers to maintain a great welcoming environment that brings a sense of security and warmth.' },
];
const subject = encodeURIComponent('Application — Barista / Shopkeeper');
---
<Base
  title="Careers — Barista / Shopkeeper Jobs in New Albany, IN | Kølkin Coffee"
  description="Join Kølkin Coffee as a Barista / Shopkeeper in New Albany, Indiana. Craft great coffee, build community with every guest, and keep the shop warm and welcoming."
>
  <section class="cr wrap" aria-labelledby="cr-title">
    <div class="cr-head">
      <p class="label eyebrow" data-reveal>Careers · Available position</p>
      <Lines as="h1" id="cr-title" class="display" lines={['Barista /', '*Shopkeeper.*']} />
      <p class="lead" data-reveal style="--d:.15s">We use the term Shopkeeper to describe the three responsibilities necessary for employment at Kølkin Coffee.</p>
    </div>
    <div class="cr-img media" data-reveal="mask"><Image src={orderHere} alt="A Kølkin shopkeeper at work behind the counter" widths={[480, 800]} sizes="(min-width: 1000px) 34vw, 100vw" loading="eager" /></div>

    <ol class="cr-roles">
      {roles.map((r) => (
        <li data-reveal><span class="label num">{r.n}</span><h2 class="h2">{r.t}</h2><p class="body-copy">{r.d}</p></li>
      ))}
    </ol>

    <div class="cr-apply on-dark" data-reveal>
      <h2 class="h1">Ready to <em>apply?</em></h2>
      <p class="body-copy">Send your resume along with a short explanation of why you would make a great member of our team.</p>
      <a class="btn btn--light" href={`mailto:${business.careersEmail}?subject=${subject}`}>Email {business.careersEmail} <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .cr { padding-top: calc(var(--header-h) + clamp(40px, 7vw, 110px)); padding-bottom: clamp(72px, 10vw, 150px); display: grid; gap: 48px; }
  .cr-head { display: grid; gap: 22px; align-content: end; }
  .cr-img { aspect-ratio: 4 / 5; }
  .cr-roles { display: grid; border-top: 1px solid var(--line); }
  .cr-roles li { display: grid; gap: 12px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .cr-roles .label { color: var(--copper); }
  .cr-apply { padding: clamp(28px, 5vw, 64px); display: grid; gap: 20px; justify-items: start; }
  .cr-apply .body-copy { color: rgba(243,237,226,.78); }
  .cr-apply .btn { white-space: normal; text-align: left; }
  @media (min-width: 1000px) {
    .cr { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .cr-head { grid-column: 1 / 8; }
    .cr-img { grid-column: 9 / 13; }
    .cr-roles { grid-column: 1 / -1; }
    .cr-roles li { grid-template-columns: 80px 4fr 6fr; gap: var(--gutter); align-items: baseline; }
    .cr-apply { grid-column: 1 / -1; }
  }
</style>
