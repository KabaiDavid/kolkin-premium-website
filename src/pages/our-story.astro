---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Arrow from '../components/Arrow.astro';
import { business, SITE_URL } from '../data/site';

import river from '../assets/photos/river-eddies.jpg';
import eddyDetail from '../assets/photos/river-eddy-detail.jpg';
import farm from '../assets/photos/coffee-farm.jpg';
import lounge from '../assets/photos/shop-lounge.jpg';
import badge from '../assets/kolkin-badge.png';
import cup from '../assets/photos/cup-in-hand.jpg';

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Our Story — Kølkin Coffee',
  url: `${SITE_URL}/our-story`,
  about: { '@id': `${SITE_URL}/#business` },
}];
---
<Base
  title="Our Story — Born From the River | Kølkin Coffee, Southern Indiana"
  description="Kølkin is the Danish word for “river eddy” — the calm water where kayakers rest before the next rapid. A family-owned, veteran- and woman-led coffee roaster serving Southern Indiana and Louisville since 2014."
  overlayHeader
  jsonld={jsonld}
>
  <section class="s-hero on-dark" aria-labelledby="s-title">
    <div class="s-hero-media" aria-hidden="true">
      <Image src={river} alt="" widths={[900, 1365]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap s-hero-inner">
      <p class="label" data-reveal>Our story · Est. {business.founded}</p>
      <Lines as="h1" id="s-title" class="mega" lines={['Born from', 'the *outdoors.*']} delay={0.2} />
    </div>
  </section>

  <section class="section chapter ch1" aria-labelledby="c1">
    <div class="wrap ch-grid">
      <aside class="ch-label"><span class="label num">I.</span><span class="label">The eddy</span></aside>
      <div class="ch-main">
        <h2 id="c1" class="h1" data-reveal>A place where the current slows.</h2>
        <div class="ch-cols">
          <p class="lead" data-reveal>For centuries, those who travel the waterways have known the river eddy — a place where the current slows and the water turns calm. After running the rapids, whitewater kayakers seek the eddy to rest, regroup, and plan their next line down the river.</p>
          <div class="body-copy" data-reveal style="--d:.1s">
            <p><strong>Kølkin is the Danish word for “river eddy.”</strong></p>
            <p>Here in Southern Indiana, we exist to offer that same place of pause — through craft coffee roasted in small batches and a welcoming community built around it.</p>
            <p>Whether you’re stopping in for a cup, ordering beans for your home, or partnering with us for wholesale, Kølkin is a place to gather, reset, and move forward well.</p>
          </div>
        </div>
      </div>
      <figure class="ch-fig">
        <div class="media" data-reveal="mask"><Image src={eddyDetail} alt="Calm water curling behind a boulder in a fast river — an eddy" widths={[480, 800]} sizes="(min-width: 1000px) 28vw, 80vw" loading="lazy" /></div>
      </figure>
    </div>
  </section>

  <section class="pull on-cream" aria-label="In our own words">
    <div class="wrap pull-inner">
      <Image src={badge} alt="Kølkin Coffee & Roastery badge — a river winding through pines toward a mountain at sunset, est. 2014" width={320} height={320} class="pull-badge" loading="lazy" />
      <blockquote class="pull-quote" data-reveal>
        <p>“Coffee is more than a drink — it’s a catalyst for connection, creativity, and community.”</p>
      </blockquote>
    </div>
  </section>

  <section class="section chapter ch2" aria-labelledby="c2">
    <div class="wrap ch-grid ch-grid--flip">
      <aside class="ch-label"><span class="label num">II.</span><span class="label">The craft</span></aside>
      <figure class="ch-fig ch-fig--wide">
        <div class="media" data-reveal="mask"><Image src={farm} alt="A coffee farmer picks ripe cherries by hand on a shaded hillside" widths={[640, 1000, 1500]} sizes="(min-width: 1000px) 60vw, 100vw" loading="lazy" /></div>
      </figure>
      <div class="ch-main">
        <h2 id="c2" class="h1" data-reveal>Sourced with intention. <em>Roasted in small batches.</em></h2>
        <div class="body-copy" data-reveal>
          <p>We source with intention — working directly with growers and trusted importers to bring you coffees that are traceable, consistent, and exceptional in the cup.</p>
          <p>Every roast is crafted in small batches to ensure freshness and quality you can taste and stand behind. As Jeffersonville, Indiana’s only active coffee roaster, we roast for our own bar, for homes across the country, and for the cafés, offices and restaurants we supply.</p>
        </div>
        <a class="link" href="/collections/coffee" data-reveal>Explore the coffee <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section chapter ch3 on-dark" aria-labelledby="c3">
    <div class="wrap ch-grid">
      <aside class="ch-label"><span class="label num">III.</span><span class="label">The people</span></aside>
      <div class="ch-main">
        <h2 id="c3" class="h1" data-reveal>Family-owned. <em>Veteran- and woman-led.</em></h2>
        <div class="ch-cols">
          <div class="body-copy" data-reveal>
            <p>Kølkin is fueled by our love for community, the outdoors, and artisan craft. For more than eleven years, we’ve been serving Southern Indiana and Louisville, one cup at a time.</p>
            <p>Rooted in Southern Indiana and Kentuckiana, our journey is fueled by obedience to God’s calling and a desire to use our craft for His will.</p>
          </div>
          <div class="body-copy" data-reveal style="--d:.1s">
            <p>Our shopkeepers make every drink to the menu, keep the shop warm and welcoming — and talk with you. Even in the drive-through, we don’t use headsets: conversation and politeness come first.</p>
            <p>And yes, there are kayaks in the shop.</p>
          </div>
        </div>
      </div>
      <figure class="ch-fig">
        <div class="media" data-reveal="mask"><Image src={lounge} alt="Guests relaxing in the Kølkin coffee shop lounge" widths={[480, 800, 1200]} sizes="(min-width: 1000px) 28vw, 80vw" loading="lazy" /></div>
      </figure>
    </div>
  </section>

  <section class="section chapter ch4" aria-labelledby="c4">
    <div class="wrap ch-grid ch-grid--flip">
      <aside class="ch-label"><span class="label num">IV.</span><span class="label">The next move</span></aside>
      <figure class="ch-fig">
        <div class="media" data-reveal="mask"><Image src={cup} alt="A mug of Kølkin coffee held in two hands" widths={[480, 800]} sizes="(min-width: 1000px) 28vw, 80vw" loading="lazy" /></div>
      </figure>
      <div class="ch-main">
        <h2 id="c4" class="h1" data-reveal>From a local favorite <em>to your kitchen.</em></h2>
        <div class="body-copy" data-reveal>
          <p>With our roasting facility, online shop, and wholesale distribution, we’re expanding our reach to homes, cafés, and businesses across the United States.</p>
          <p>Wherever you are, the invitation is the same: pause, reset, and move forward well.</p>
        </div>
        <div class="ch-ctas" data-reveal>
          <a class="btn" href="/collections/coffee">Shop the coffee <Arrow /></a>
          <a class="link" href="/wholesale">Wholesale partnerships</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .s-hero { position: relative; min-height: 92svh; display: flex; align-items: flex-end; overflow: hidden; }
  .s-hero-media { position: absolute; inset: 0; }
  .s-hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 30% 60%; filter: saturate(.55) contrast(1.05) brightness(.62) sepia(.12); }
  .motion .s-hero-media :global(img) { animation: slow-zoom 30s linear infinite alternate; }
  @keyframes slow-zoom { to { transform: scale(1.08) translateX(-1%); } }
  .s-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(14,17,15,.85), rgba(14,17,15,.1) 60%); }
  .s-hero-inner { position: relative; z-index: 1; padding-block: calc(var(--header-h) + 10vh) clamp(56px, 8vw, 110px); display: grid; gap: 22px; }

  .ch-grid { display: grid; gap: 32px; }
  .ch-label { display: flex; gap: 12px; color: var(--copper); }
  .on-dark .ch-label { color: var(--copper-light); }
  .ch-main { display: grid; gap: 28px; align-content: start; justify-items: start; }
  .ch-main .h1 { max-width: 16ch; }
  .ch-cols { display: grid; gap: 24px; }
  .ch-fig .media { aspect-ratio: 4 / 5; }
  .ch-fig--wide .media { aspect-ratio: 3 / 2; }
  .ch-ctas { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; }
  .on-dark .body-copy { color: rgba(243,237,226,.74); }
  .body-copy strong { color: var(--ink); font-weight: 600; }

  .pull { padding-block: clamp(72px, 10vw, 150px); }
  .pull-inner { display: grid; gap: 36px; justify-items: center; text-align: center; }
  .pull :global(.pull-badge) { width: clamp(150px, 18vw, 220px); height: auto; }
  .pull-quote p { font: 300 clamp(1.9rem, 4.2vw, 3.8rem)/1.1 var(--serif); font-style: italic; letter-spacing: -.02em; max-width: 22ch; text-wrap: balance; }

  @media (min-width: 1000px) {
    .ch-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .ch-label { grid-column: 1 / 3; flex-direction: column; position: sticky; top: calc(var(--header-h) + 32px); align-self: start; }
    .ch-main { grid-column: 3 / 9; }
    .ch-cols { grid-template-columns: 1fr 1fr; gap: var(--gutter); }
    .ch-fig { grid-column: 9 / 13; margin-top: 120px; }
    .ch-grid--flip .ch-fig { grid-column: 3 / 7; grid-row: 1; margin-top: 0; }
    .ch-grid--flip .ch-main { grid-column: 8 / 13; grid-row: 1; padding-top: 80px; }
    .ch-grid--flip .ch-fig--wide { grid-column: 3 / 13; grid-row: 1; }
    .ch2 .ch-main { grid-column: 3 / 10; grid-row: 2; padding-top: 0; margin-top: 64px; }
    .ch2 .ch-main .body-copy { columns: 2; column-gap: var(--gutter); max-width: none; }
    .ch2 .ch-main .body-copy p { break-inside: avoid; }
  }
</style>
