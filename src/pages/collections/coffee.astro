---
import Base from '../../layouts/Base.astro';
import Lines from '../../components/Lines.astro';
import Arrow from '../../components/Arrow.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, money } from '../../data/catalog';
import { business, SITE_URL } from '../../data/site';

const sizes = products[0].variants.map((v) => ({ title: v.title, price: v.price }));
const uniformPricing = products.every((p) => p.variants.map((v) => v.price).join() === sizes.map((s) => s.price).join());

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Kølkin Coffee — fresh roasted coffee beans',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}/products/${p.handle}`, name: p.title })),
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Coffee', item: `${SITE_URL}/collections/coffee` },
  ],
}];
---
<Base
  title="Fresh Roasted Coffee Beans — Single Origin & Espresso | Kølkin Coffee"
  description="Shop small-batch, fresh roasted whole bean coffee from Kølkin: single origins from Guatemala, Colombia and Ethiopia, our espresso blend and a Swiss Water decaf. Roasted in Southern Indiana."
  jsonld={jsonld}
>
  <header class="col-head wrap">
    <p class="label eyebrow" data-reveal>The coffee · {products.length} roasts</p>
    <Lines as="h1" class="mega col-title" lines={['Small batch.', '*Whole bean.*']} />
    <div class="col-intro">
      <p class="lead">Single origins and a house espresso blend, roasted in small batches in Southern Indiana and sold as whole bean.</p>
      {uniformPricing && (
        <ul class="col-sizes" aria-label="Bag sizes and prices">
          {sizes.map((s) => <li><span class="h3">{s.title}</span><span class="num">{money(s.price)}</span></li>)}
        </ul>
      )}
    </div>
  </header>

  <section class="wrap col-grid" aria-label="All coffees">
    {products.map((p, i) => (
      <div class={`cell cell--${i}`} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
        <ProductCard product={p} index={i + 1} eager={i < 2} />
      </div>
    ))}
    <aside class="cell cell--note on-dark" data-reveal aria-label="Buying notes">
      <p class="label eyebrow">Good to know</p>
      <ul>
        <li><span class="h3">Free shipping</span><span>On orders over ${business.freeShippingThreshold}.</span></li>
        <li><span class="h3">Subscribe &amp; save 10%</span><span>Recurring deliveries are managed on our <a class="text-link" href={`${products[0].shopifyUrl}`}>Shopify store</a>.</span></li>
        <li><span class="h3">For your business</span><span>5 lb and 25 lb formats at $11 / lb. <a class="text-link" href="/wholesale">Wholesale</a></span></li>
      </ul>
      <a class="btn btn--light" href={business.giftCardsUrl} target="_blank" rel="noopener">Gift cards <Arrow /></a>
    </aside>
  </section>

  <section class="section col-visit" aria-labelledby="cv-t">
    <div class="wrap cv-grid">
      <h2 id="cv-t" class="h1">Rather taste it <em>first?</em></h2>
      <p class="body-copy">Every coffee on this page is on the bar at our New Albany shop — {business.address.street}. Come in, or pull through the drive-through.</p>
      <a class="link" href="/visit">Plan your visit <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .col-head { padding-top: calc(var(--header-h) + clamp(40px, 7vw, 110px)); padding-bottom: clamp(48px, 7vw, 100px); display: grid; gap: 26px; }
  :global(.col-title) { font-size: clamp(3.6rem, 9.4vw, 10rem); }
  .col-intro { display: grid; gap: 28px; max-width: 560px; }
  .col-sizes { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .col-sizes li { display: grid; gap: 4px; padding-top: 14px; }
  .col-sizes li + li { border-left: 1px solid var(--line); padding-left: 14px; }
  .col-sizes .num { color: var(--ink-soft); font-size: .95rem; }
  @media (min-width: 1000px) {
    .col-head { grid-template-columns: 7fr 5fr; align-items: end; column-gap: var(--gutter); }
    .col-head > .label { grid-column: 1 / -1; }
    .col-intro { padding-bottom: 1.4vw; }
  }

  .col-grid { display: grid; gap: 48px 14px; grid-template-columns: 1fr; padding-bottom: clamp(64px, 9vw, 140px); }
  .cell--note { padding: 32px 26px; display: grid; gap: 26px; align-content: start; background: var(--forest); }
  .cell--note ul { display: grid; gap: 22px; }
  .cell--note li { display: grid; gap: 6px; }
  .cell--note li > span:last-child { color: rgba(243,237,226,.72); font-size: .95rem; }
  .cell--note .btn { justify-self: start; }
  @media (min-width: 700px) { .col-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) {
    .col-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 80px; }
    .cell--0 { grid-column: 1 / 8; }
    .cell--1 { grid-column: 9 / 13; margin-top: 30%; }
    .cell--2 { grid-column: 1 / 5; }
    .cell--3 { grid-column: 5 / 9; margin-top: 18%; }
    .cell--4 { grid-column: 9 / 13; }
    .cell--note { grid-column: 1 / 6; }
  }
  .col-visit { background: var(--cream); }
  .cv-grid { display: grid; gap: 22px; justify-items: start; max-width: 760px; }
</style>
