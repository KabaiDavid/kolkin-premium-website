---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Arrow from '../components/Arrow.astro';
import FormNotice from '../components/FormNotice.astro';
import { business, SHOP_DOMAIN, SITE_URL } from '../data/site';
import { products } from '../data/catalog';

import farm from '../assets/photos/coffee-farm.jpg';
import bar from '../assets/photos/shop-espresso-bar.jpg';

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kølkin Coffee wholesale',
  serviceType: 'Wholesale specialty coffee supply',
  provider: { '@id': `${SITE_URL}/#business` },
  areaServed: 'US',
  url: `${SITE_URL}/wholesale`,
  offers: [
    { '@type': 'Offer', name: '5 lb bag (minimum 2 bags)', price: '55.00', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Bulk 25 lb', price: '275.00', priceCurrency: 'USD' },
  ],
}];
---
<Base
  title="Wholesale Coffee Supplier — Specialty Coffee Beans at $11/lb | Kølkin Coffee"
  description="Partner with Kølkin Coffee for wholesale specialty coffee: fresh roasted beans for cafés, restaurants, offices and retailers. 5 lb and 25 lb formats at $11/lb, private label programs, one-week lead times."
  jsonld={jsonld}
>
  <section class="w-hero on-roast" aria-labelledby="w-title">
    <div class="w-hero-img" aria-hidden="true">
      <Image src={bar} alt="" widths={[900, 1400, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap w-hero-inner">
      <p class="label eyebrow" data-reveal>Wholesale partnerships</p>
      <Lines as="h1" id="w-title" class="mega" lines={['Coffee that', 'builds *connection.*']} delay={0.15} />
      <div class="w-hero-foot">
        <p class="lead">We partner with cafés, offices, restaurants, and hospitality businesses that care about what’s in the cup. If you’re looking for a reliable, quality-focused coffee supplier, we’d love to work with you.</p>
        <a href="#apply" class="btn btn--light">Let’s build a partnership <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-t">
    <div class="wrap who-grid">
      <h2 id="who-t" class="h1" data-reveal>Who we supply</h2>
      <ol class="who">
        {[
          ['Independent cafés', '& coffee shops'],
          ['Restaurants', '& hospitality venues'],
          ['Corporate offices', '& coworking spaces'],
          ['Specialty grocery', '& retail stores'],
        ].map(([a, b], i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}><span class="label num">{String(i + 1).padStart(2, '0')}</span><span class="h3">{a} <em>{b}</em></span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section on-cream pricing" aria-labelledby="price-t">
    <div class="wrap price-grid">
      <header class="price-head">
        <p class="label eyebrow" data-reveal>Pricing &amp; minimums</p>
        <h2 id="price-t" class="display" data-reveal>$11 <em>per pound.</em></h2>
        <p class="body-copy" data-reveal>Volume discounts are available for orders over 50 lbs / month. Reach out to discuss a program tailored to your needs.</p>
      </header>
      <div class="tiers">
        <article class="tier" data-reveal>
          <p class="label tier-k">Format</p>
          <h3 class="h2">5 lb bag</h3>
          <p class="tier-price num">$55 <span>/ bag</span></p>
          <dl><div><dt>Minimum</dt><dd>2 bags (10 lbs)</dd></div><div><dt>Per pound</dt><dd class="num">$11</dd></div></dl>
        </article>
        <article class="tier" data-reveal style="--d:.08s">
          <p class="label tier-k">Format</p>
          <h3 class="h2">Bulk 25 lb</h3>
          <p class="tier-price num">$275 <span>/ unit</span></p>
          <dl><div><dt>Minimum</dt><dd>1 unit</dd></div><div><dt>Per pound</dt><dd class="num">$11</dd></div></dl>
        </article>
        <article class="tier tier--dark on-dark" data-reveal style="--d:.16s">
          <p class="label tier-k">Program</p>
          <h3 class="h2">Custom &amp; private label</h3>
          <p class="tier-price num">$11 <span>/ lb</span></p>
          <dl><div><dt>Minimum</dt><dd>50 lbs / month</dd></div><div><dt>Development</dt><dd class="num">$350 one-time</dd></div></dl>
        </article>
      </div>
      <div class="lead-times" data-reveal>
        <h3 class="label">Lead times</h3>
        <dl>
          <div><dt>All standard orders</dt><dd>1 week</dd></div>
          <div><dt>Custom / private label</dt><dd>1 week after development approval</dd></div>
          <div><dt>First-time orders</dt><dd>Allow up to 1 week while we set up your account</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section source" aria-labelledby="src-t">
    <div class="wrap src-grid">
      <div class="media src-img" data-reveal="mask"><Image src={farm} alt="Ripe coffee cherries being harvested by hand" widths={[640, 1000, 1400]} sizes="(min-width: 1000px) 55vw, 100vw" loading="lazy" /></div>
      <div class="src-txt">
        <p class="label eyebrow" data-reveal>Our story &amp; sourcing</p>
        <h2 id="src-t" class="h1" data-reveal>A story worth <em>telling.</em></h2>
        <div class="body-copy" data-reveal>
          <p>At Kølkin Coffee, we source with intention — working directly with growers and trusted importers to bring you coffees that are traceable, consistent, and exceptional in the cup. Every roast is crafted in small batches to ensure freshness and quality you can taste and stand behind.</p>
          <p>When you partner with Kølkin, you’re not just buying coffee — you’re offering your customers a story worth telling.</p>
        </div>
        <ul class="src-coffees" data-reveal aria-label="Current coffees">
          {products.map((p) => <li><a href={`/products/${p.handle}`}>{p.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="apply" class="section on-dark apply" aria-labelledby="apply-t">
    <div class="wrap apply-grid">
      <header class="apply-head">
        <p class="label eyebrow">Apply</p>
        <h2 id="apply-t" class="display">Let’s build a <em>partnership.</em></h2>
        <p class="lead">Tell us about your business and we’ll be in touch within 1–2 business days.</p>
        <p class="apply-alt">Already on RangeMe? You can also find and connect with us through <a class="text-link" href={business.rangeMeUrl} target="_blank" rel="noopener">RangeMe</a>. Prefer email? <a class="text-link" href={`mailto:${business.email}?subject=Wholesale%20inquiry`}>{business.email}</a></p>
      </header>

      <form class="apply-form" method="post" action={`${SHOP_DOMAIN}/contact#wholesale`} accept-charset="UTF-8">
        <FormNotice kind="contact" message="Thank you — your wholesale inquiry is in. We’ll be in touch within 1–2 business days." />
        <input type="hidden" name="form_type" value="contact" />
        <input type="hidden" name="utf8" value="✓" />
        <input type="hidden" name="contact[subject]" value="Wholesale inquiry" />
        <div class="field"><label for="w-name">Your name</label><input id="w-name" class="input" type="text" name="contact[name]" autocomplete="name" placeholder="Jane Smith" required /></div>
        <div class="field"><label for="w-email">Email address</label><input id="w-email" class="input" type="email" name="contact[email]" autocomplete="email" placeholder="jane@yourbusiness.com" required /></div>
        <div class="field"><label for="w-phone">Phone number <span class="opt">(optional)</span></label><input id="w-phone" class="input" type="tel" name="contact[phone]" autocomplete="tel" placeholder="(555) 000-0000" /></div>
        <div class="field"><label for="w-biz">Business name</label><input id="w-biz" class="input" type="text" name="contact[business]" autocomplete="organization" placeholder="Your café or restaurant" required /></div>
        <div class="field"><label for="w-type">Business type</label>
          <select id="w-type" class="input" name="contact[business_type]" required>
            <option value="">Select one…</option>
            <option value="cafe">Café / Coffee Shop</option>
            <option value="restaurant">Restaurant</option>
            <option value="office">Office / Coworking Space</option>
            <option value="retail">Specialty Retail</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field"><label for="w-vol">Estimated monthly volume</label>
          <select id="w-vol" class="input" name="contact[monthly_volume]">
            <option value="">Select one…</option>
            <option value="under_10">Under 10 lbs</option>
            <option value="10_25">10–25 lbs</option>
            <option value="25_50">25–50 lbs</option>
            <option value="50_plus">50+ lbs</option>
          </select>
        </div>
        <div class="field field--full"><label for="w-msg">Anything else you’d like us to know?</label><textarea id="w-msg" class="input" name="contact[body]" rows="4" placeholder="Tell us about your business, current coffee program, or any questions you have."></textarea></div>
        <div class="field--full apply-submit">
          <button type="submit" class="btn btn--light">Submit wholesale inquiry <Arrow /></button>
          <p class="apply-fine">Sent securely through our Shopify store’s contact system.</p>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .w-hero { position: relative; min-height: 88svh; display: flex; align-items: flex-end; overflow: hidden; }
  .w-hero-img { position: absolute; inset: 0; }
  .w-hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: brightness(.42) saturate(.75) sepia(.2); }
  .w-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(51,36,27,.95), rgba(51,36,27,.2) 70%); }
  .w-hero-inner { position: relative; z-index: 1; padding-block: calc(var(--header-h) + 12vh) clamp(56px, 8vw, 110px); display: grid; gap: 26px; }
  .w-hero-foot { display: grid; gap: 24px; justify-items: start; max-width: 620px; }
  .w-hero-foot .lead { color: rgba(243,237,226,.85); }
  @media (min-width: 1000px) { .w-hero-foot { grid-template-columns: 1fr auto; max-width: none; align-items: end; gap: 48px; } .w-hero-foot .lead { max-width: 46ch; } }

  .who-grid { display: grid; gap: 36px; }
  .who { border-top: 1px solid var(--line); }
  .who li { display: flex; gap: 22px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .who .label { color: var(--copper); }
  .who em { color: var(--ink-soft); }
  @media (min-width: 1000px) { .who-grid { grid-template-columns: 5fr 7fr; gap: var(--gutter); } .who .h3 { font-size: clamp(1.6rem, 2.4vw, 2.3rem); } }

  .price-grid { display: grid; gap: 48px; }
  .price-head { display: grid; gap: 22px; max-width: 640px; }
  .tiers { display: grid; gap: 14px; }
  .tier { padding: 28px 24px; background: var(--paper); display: grid; gap: 14px; align-content: start; border: 1px solid var(--line); }
  .tier--dark { background: var(--forest); border-color: var(--forest); }
  .tier-k { color: var(--copper); }
  .tier--dark .tier-k { color: var(--copper-light); }
  .tier-price { font: 300 3rem/1 var(--serif); letter-spacing: -.02em; }
  .tier-price span { font: 400 1rem var(--sans); color: var(--ink-soft); }
  .tier dl { display: grid; margin-top: 10px; }
  .tier dl div { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--line); font-size: .95rem; }
  .tier dt { color: var(--ink-soft); }
  .lead-times { display: grid; gap: 16px; }
  .lead-times .label { color: var(--copper); }
  .lead-times dl div { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .lead-times dt { font: 380 1.2rem var(--serif); }
  .lead-times dd { color: var(--ink-soft); }
  @media (min-width: 900px) {
    .tiers { grid-template-columns: repeat(3, 1fr); }
    .lead-times dl div { grid-template-columns: 1fr 1fr; }
  }

  .src-grid { display: grid; gap: 40px; align-items: center; }
  .src-img { aspect-ratio: 4 / 3; }
  .src-txt { display: grid; gap: 22px; }
  .src-coffees { display: flex; flex-wrap: wrap; gap: 8px; }
  .src-coffees a { display: inline-block; padding: 10px 12px; border: 1px solid var(--line); font-size: .85rem; transition: border-color .3s, color .3s; }
  .src-coffees a:hover { border-color: var(--copper); color: var(--copper); }
  @media (min-width: 1000px) { .src-grid { grid-template-columns: 7fr 5fr; gap: calc(var(--gutter) * 2); } }

  .apply-grid { display: grid; gap: 48px; }
  .apply-head { display: grid; gap: 22px; align-content: start; }
  .apply-head .lead { color: rgba(243,237,226,.85); max-width: 36ch; }
  .apply-alt { font-size: .95rem; color: rgba(243,237,226,.7); max-width: 44ch; }
  .apply-form { display: grid; gap: 30px 28px; }
  .apply-form .input { border-bottom-color: rgba(243,237,226,.35); }
  .opt { text-transform: none; letter-spacing: 0; font-weight: 400; opacity: .6; }
  .apply-submit { display: grid; gap: 12px; justify-items: start; }
  .apply-fine { font-size: .8rem; color: rgba(243,237,226,.55); }
  .apply-form :global(.form-notice) { grid-column: 1 / -1; }
  @media (min-width: 760px) { .apply-form { grid-template-columns: 1fr 1fr; } .field--full { grid-column: 1 / -1; } }
  @media (min-width: 1100px) { .apply-grid { grid-template-columns: 5fr 7fr; gap: calc(var(--gutter) * 2); } .apply-head { position: sticky; top: calc(var(--header-h) + 32px); align-self: start; } }
</style>
