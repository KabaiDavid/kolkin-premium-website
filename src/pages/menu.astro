---
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Arrow from '../components/Arrow.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { menu } from '../data/menu';
import { business, SITE_URL } from '../data/site';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const $ = (p: string | null | undefined) => (p ? `$${p}` : '—');

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Kølkin Coffee café menu',
  url: `${SITE_URL}/menu`,
  hasMenuSection: menu.map((g) => ({
    '@type': 'MenuSection',
    name: g.group,
    hasMenuItem: g.sections.flatMap((s): Record<string, unknown>[] =>
      s.kind === 'table'
        ? s.rows.map((r) => ({ '@type': 'MenuItem', name: s.rows.length === 1 ? s.title : `${s.title} — ${r.name}`, offers: r.prices.map((p, i) => p && ({ '@type': 'Offer', price: p, priceCurrency: 'USD', name: s.columns[i] })).filter(Boolean) }))
        : s.items.map((it) => ({ '@type': 'MenuItem', name: it.name, description: it.desc, ...(it.price ? { offers: { '@type': 'Offer', price: it.price, priceCurrency: 'USD' } } : {}) })),
    ),
  })),
}];
---
<Base
  title="Café Menu — Coffee, Signature Lattes & Breakfast | Kølkin Coffee New Albany"
  description="The full Kølkin Coffee café menu: drip and pour-over coffee, signature lattes like the Kayaker and Black Bear, matcha, cold brew, and breakfast sandwiches made in house. New Albany, IN."
  jsonld={jsonld}
>
  <header class="m-head wrap">
    <p class="label eyebrow" data-reveal>At the bar · {business.address.city}</p>
    <Lines as="h1" class="mega" lines={['The *menu.*']} />
    <div class="m-meta" data-reveal style="--d:.15s">
      <OpenStatus />
      <p class="body-copy">Order at the counter, through the drive-through, or text ahead for pickup.</p>
      <a class="link" href="/visit#order-ahead">Order ahead <Arrow /></a>
    </div>
  </header>

  <nav class="m-tabs" aria-label="Menu sections">
    <ul class="wrap">
      {menu.map((g) => <li><a href={`#${slug(g.group)}`}>{g.group}</a></li>)}
    </ul>
  </nav>

  <div class="wrap m-body">
    {menu.map((g) => (
      <section id={slug(g.group)} class="m-group" aria-labelledby={`${slug(g.group)}-t`}>
        <h2 id={`${slug(g.group)}-t`} class="display m-group-title">{g.group}</h2>
        <div class="m-sections">
          {g.sections.map((s) => (
            <div class="m-sec" data-reveal>
              <h3 class="label m-sec-title">{s.title}</h3>
              {s.note && <p class="m-note">{s.note}</p>}
              {s.kind === 'table' ? (
                <div class="m-scroll">
                  <table class="m-table">
                    <caption class="sr-only">{s.title} prices by size</caption>
                    <thead><tr><th scope="col"><span class="sr-only">Drink</span></th>{s.columns.map((c) => <th scope="col" class="num">{c}</th>)}</tr></thead>
                    <tbody>
                      {s.rows.map((r) => <tr><th scope="row">{r.name}</th>{r.prices.map((p) => <td class="num">{$(p)}</td>)}</tr>)}
                    </tbody>
                  </table>
                </div>
              ) : (
                <ul class="m-list">
                  {s.items.map((it) => (
                    <li>
                      <div class="m-item"><span class="m-name">{it.name}</span>{it.price && <><span class="m-dots" aria-hidden="true"></span><span class="num">${it.price}</span></>}</div>
                      {it.desc && <p class="m-desc">{it.desc}</p>}
                      {it.extra?.map((x) => <p class="m-desc m-extra">{x}</p>)}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}
    <p class="m-fine label label--muted">Prices as listed at kolkin.coffee and subject to change in the shop.</p>
  </div>
</Base>

<style>
  .m-head { padding-top: calc(var(--header-h) + clamp(40px, 7vw, 110px)); padding-bottom: clamp(40px, 5vw, 72px); display: grid; gap: 24px; }
  .m-meta { display: grid; gap: 14px; justify-items: start; max-width: 440px; }
  @media (min-width: 1000px) { .m-head { grid-template-columns: 1fr auto; align-items: end; } .m-head > .label { grid-column: 1 / -1; } }
  .m-tabs { position: sticky; top: var(--header-h); transition: top .6s var(--ease); z-index: 30; background: var(--paper); border-block: 1px solid var(--line); }
  :global(html[data-header-hidden]) .m-tabs { top: 0; }
  .m-tabs ul { display: flex; gap: 28px; overflow-x: auto; scrollbar-width: none; }
  .m-tabs a { display: block; padding: 16px 0; white-space: nowrap; font: 560 var(--fs-label)/1 var(--sans); font-stretch: 118%; letter-spacing: .16em; text-transform: uppercase; }
  .m-tabs a:hover, .m-tabs a.is-active { color: var(--copper); }
  .m-body { padding-bottom: clamp(72px, 10vw, 150px); }
  .m-group { padding-top: clamp(56px, 7vw, 110px); scroll-margin-top: 60px; }
  .m-group-title { margin-bottom: 36px; }
  .m-sections { display: grid; gap: 48px; }
  .m-sec-title { color: var(--copper); padding-bottom: 12px; border-bottom: 1px solid var(--ink); }
  .m-note { margin-top: 12px; font: italic 360 1.05rem/1.45 var(--serif); color: var(--ink-soft); }
  .m-scroll { overflow-x: auto; }
  .m-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
  .m-table th, .m-table td { padding: 12px 0; border-bottom: 1px solid var(--line); text-align: right; font-weight: 400; }
  .m-table thead th { font: 560 .68rem/1 var(--sans); letter-spacing: .14em; color: var(--ink-soft); padding-top: 14px; }
  .m-table tbody th { text-align: left; font: 380 1.12rem/1.3 var(--serif); padding-right: 12px; }
  .m-table td { width: 64px; font-size: .95rem; }
  .m-list li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .m-item { display: flex; align-items: baseline; gap: 10px; }
  .m-name { font: 380 1.12rem/1.3 var(--serif); }
  .m-dots { flex: 1; border-bottom: 1px dotted color-mix(in srgb, var(--ink) 35%, transparent); transform: translateY(-4px); }
  .m-item .num { font-size: .95rem; }
  .m-desc { font-size: .9rem; color: var(--ink-soft); margin-top: 4px; }
  .m-extra { font-size: .85rem; }
  .m-fine { margin-top: 64px; }
  @media (min-width: 900px) { .m-sections { grid-template-columns: 1fr 1fr; column-gap: calc(var(--gutter) * 2); row-gap: 64px; } }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.m-tabs a');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) links.forEach((l) => l.classList.toggle('is-active', l.hash === `#${e.target.id}`));
  }), { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('.m-group').forEach((g) => io.observe(g));
</script>
