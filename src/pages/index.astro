<script>
  // Beat reveals inside the sticky eddy section
  const beats = document.querySelectorAll('.beat');
  if (beats.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-in', e.isIntersecting)), { threshold: 0.45 });
    beats.forEach((b) => io.observe(b));
    const ticks = document.querySelectorAll<HTMLElement>('.eddy-ticks li');
    const io2 = new IntersectionObserver((es) => es.forEach((e) => {
      const k = [...beats].indexOf(e.target);
      if (e.isIntersecting) ticks.forEach((t, i) => { t.style.color = i === k ? 'var(--cream)' : ''; });
    }), { threshold: 0.5 });
    beats.forEach((b) => io2.observe(b));
  }
</script>
