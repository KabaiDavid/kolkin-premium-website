---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Arrow from '../components/Arrow.astro';
import Discovery from '../components/Discovery.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { business, hoursSummary } from '../data/site';
import { products } from '../data/catalog';

import cup from '../assets/photos/cup-in-hand.jpg';
import eddyDetail from '../assets/photos/river-eddy-detail.jpg';
import farm from '../assets/photos/coffee-farm.jpg';
import lounge from '../assets/photos/shop-lounge.jpg';
import counter from '../assets/photos/shop-counter.jpg';
import bar from '../assets/photos/shop-espresso-bar.jpg';
import orderHere from '../assets/photos/shop-order-here.jpg';
import espressoBag from '../assets/bags/kolkin-espresso-blend.png';

const beats = [
  { n: '01', title: 'The *current.*', copy: 'Every day has its rapids.' },
  { n: '02', title: 'The *pause.*', copy: 'Then the water turns calm. Kayakers call it the eddy — a place to rest, regroup, and read the river ahead.' },
  { n: '03', title: 'The *ritual.*', copy: 'Craft coffee, roasted in small batches here in Southern Indiana.' },
  { n: '04', title: 'The *next move.*', copy: 'One good cup — then onward, well.' },
];
const fmt = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<Base
  title="Kølkin Coffee — Craft Coffee Roasted in Southern Indiana | New Albany, IN"
  description="Small-batch specialty coffee roasted in Southern Indiana. Visit our New Albany coffee shop on Charlestown Rd, shop fresh-roasted beans online, or partner with us for wholesale."
  overlayHeader
  preload={[{ href: '/textures/river.avif', as: 'image', type: 'image/avif' }]}
>
  <!-- ░░ 01 HERO ░░ -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <picture>
        <source media="(max-width: 759px)" srcset="/textures/river-900.avif" type="image/avif" />
        <source media="(max-width: 759px)" srcset="/textures/river-900.webp" type="image/webp" />
        <source srcset="/textures/river.avif" type="image/avif" />
        <img src="/textures/river.webp" alt="" width="1365" height="1365" fetchpriority="high" decoding="async" data-hero-poster />
      </picture>
      <canvas class="hero-gl" data-hero-gl></canvas>
      <div class="hero-shade"></div>
    </div>

    <div class="hero-content wrap">
      <p class="label hero-kicker" data-reveal style="--d:.2s">Est. {business.founded} · Roasted in Southern Indiana</p>
      <Lines as="h1" id="hero-title" class="display hero-title" lines={['Where the', 'current *slows.*']} delay={0.35} />
      <div class="hero-foot">
        <p class="lead hero-sub" data-reveal style="--d:.8s">Small-batch coffee.<br />A moment to pause.<br />A reason to move forward.</p>
        <div class="hero-ctas" data-reveal style="--d:.95s">
          <a href="/collections/coffee" class="btn btn--light">Explore the coffee <Arrow /></a>
          <a href="/our-story" class="link">Discover our story</a>
        </div>
      </div>
    </div>

    <div class="hero-rail wrap" aria-hidden="true">
      <span class="label">Kølkin — Danish for “river eddy”</span>
      <span class="scroll-cue label">Scroll<i></i></span>
    </div>
  </section>

  <!-- ░░ 02 THE NAME ░░ -->
  <section class="name section" aria-labelledby="name-title">
    <div class="wrap name-grid">
      <p class="label eyebrow name-eyebrow" data-reveal>The story behind the name</p>
      <h2 id="name-title" class="name-word mega" data-reveal="lines"><span class="ln"><span>Kølkin</span></span></h2>
      <p class="name-def" data-reveal style="--d:.15s"><span class="label">noun · Danish</span><span class="h3"><em>river eddy</em> — a place where the current slows and the water turns calm.</span></p>

      <figure class="name-fig">
        <div class="media" data-reveal="mask">
          <Image src={eddyDetail} alt="Aerial view of calm water curling into an eddy behind a river boulder" widths={[480, 800]} sizes="(min-width: 1000px) 30vw, 80vw" loading="lazy" />
        </div>
        <figcaption class="label label--muted">An eddy forms behind the rock — calm water beside the rapids</figcaption>
      </figure>

      <div class="name-copy">
        <p class="lead" data-reveal>For centuries, those who travel the waterways have known the river eddy. After running the rapids, whitewater kayakers seek the eddy to rest, regroup, and plan their next line down the river.</p>
        <div class="body-copy" data-reveal style="--d:.1s">
          <p>Here in Southern Indiana, we exist to offer that same place of pause — through craft coffee roasted in small batches and a welcoming community built around it.</p>
          <p>Whether you’re stopping in for a cup, ordering beans for your home, or partnering with us for wholesale, Kølkin is a place to gather, reset, and move forward well.</p>
        </div>
        <a href="/our-story" class="link" data-reveal style="--d:.2s">Read our story <Arrow /></a>
      </div>

      <ul class="name-trio" aria-label="In house, online, wholesale">
        <li data-reveal><span class="label num">i.</span><a href="/visit">In house</a></li>
        <li data-reveal style="--d:.08s"><span class="label num">ii.</span><a href="/collections/coffee">Online</a></li>
        <li data-reveal style="--d:.16s"><span class="label num">iii.</span><a href="/wholesale">Wholesale</a></li>
      </ul>
    </div>
  </section>

  <!-- ░░ 03 SIGNATURE — THE EDDY ░░ -->
  <section class="eddy on-dark" aria-label="The eddy — from river to cup" data-eddy>
    <div class="eddy-sticky">
      <canvas class="eddy-gl" data-eddy-gl aria-hidden="true"></canvas>
      <div class="eddy-fallback" aria-hidden="true">
        <img src="/textures/river-900.webp" alt="" loading="lazy" width="900" height="900" />
      </div>
      <div class="eddy-ui wrap">
        <ol class="eddy-ticks" aria-hidden="true">
          {beats.map((b, i) => <li style={`--k:${i}`}><span class="label num">{b.n}</span></li>)}
        </ol>
      </div>
    </div>
    <div class="eddy-beats">
      {beats.map((b, i) => (
        <div class="beat wrap" style={`--k:${i}`}>
          <div class="beat-inner">
            <span class="label num beat-n">{b.n} / 04</span>
            <h2 class="display beat-title" set:html={fmt(b.title)} />
            <p class="lead beat-copy">{b.copy}</p>
            {i === beats.length - 1 && <a href="#coffee" class="btn btn--light beat-cta">Find your coffee <Arrow /></a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ░░ 04 DISCOVERY ░░ -->
  <section id="coffee" class="discover section" aria-labelledby="disc-title">
    <div class="wrap">
      <header class="disc-head">
        <p class="label eyebrow" data-reveal>Fresh roasted · Whole bean</p>
        <Lines id="disc-title" class="display" lines={['Find your', '*current.*']} />
        <div class="disc-intro" data-reveal style="--d:.15s">
          <p class="body-copy">Five coffees, each roasted in small batches. Choose by what you love in the cup — bright and floral, honeyed and fruity, or deep and chocolatey.</p>
          <p class="label label--muted">12oz · 16oz · 5lb — free shipping over ${business.freeShippingThreshold}</p>
        </div>
      </header>
      <Discovery />
      <div class="disc-foot" data-reveal>
        <a href="/collections/coffee" class="link">Shop all coffee <Arrow /></a>
        <a href={products[0].shopifyUrl} class="link">Subscribe &amp; save 10% <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- ░░ 05 FROM CHERRY TO CUP ░░ -->
  <section class="craft section on-cream" aria-labelledby="craft-title">
    <div class="wrap">
      <header class="craft-head">
        <p class="label eyebrow" data-reveal>From cherry to cup</p>
        <Lines id="craft-title" class="h1" lines={['Sourced with intention.', 'Roasted in *small batches.*']} />
      </header>
      <ol class="craft-steps">
        <li class="step step--a">
          <div class="media" data-reveal="mask"><Image src={farm} alt="A coffee farmer hand-picking ripe red cherries from the branch" widths={[520, 820, 1200]} sizes="(min-width: 1000px) 34vw, 88vw" loading="lazy" /></div>
          <div class="step-txt" data-reveal>
            <span class="label num">01 — Origin</span>
            <h3 class="h3">Traceable from the farm.</h3>
            <p class="body-copy">We work directly with growers and trusted importers to bring you coffees that are traceable, consistent, and exceptional in the cup.</p>
          </div>
        </li>
        <li class="step step--b">
          <div class="roast-ramp" data-reveal="mask" role="img" aria-label="Roast colour scale from green coffee to dark, with Kølkin's current coffees at medium">
            <span style="--c:#8E9A6A">Green</span>
            <span style="--c:#C9A66A">Yellow</span>
            <span style="--c:#A4683B">Cinnamon</span>
            <span style="--c:#6E4126" class="is-ours">Medium<em>Our current five</em></span>
            <span style="--c:#3C2418">Full city</span>
            <span style="--c:#1B110C">Dark</span>
          </div>
          <div class="step-txt" data-reveal>
            <span class="label num">02 — Roast</span>
            <h3 class="h3">Small batches, for freshness you can taste.</h3>
            <p class="body-copy">Every roast is crafted in small batches here in Southern Indiana. All five coffees on our shelf today are roasted to a medium profile — balanced, sweet, and honest to their origin.</p>
          </div>
        </li>
        <li class="step step--c">
          <div class="media bag-media" data-reveal="mask"><Image src={espressoBag} alt="Kølkin Coffee Espresso Blend whole bean bag" widths={[360, 560]} sizes="(min-width: 1000px) 22vw, 60vw" loading="lazy" /></div>
          <div class="step-txt" data-reveal>
            <span class="label num">03 — Packed</span>
            <h3 class="h3">Whole bean, bagged fresh.</h3>
            <p class="body-copy">In 12oz and 16oz bags for home, and 5lb bags for the office or the café.</p>
          </div>
        </li>
        <li class="step step--d">
          <div class="media" data-reveal="mask"><Image src={cup} alt="Hands holding a hand-thrown ceramic mug of black coffee" widths={[520, 820, 1200]} sizes="(min-width: 1000px) 34vw, 88vw" loading="lazy" /></div>
          <div class="step-txt" data-reveal>
            <span class="label num">04 — Your cup</span>
            <h3 class="h3">Pour. Pause. Move forward.</h3>
            <p class="body-copy">At home, at work, or at our bar on Charlestown Road.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ░░ 06 COMMUNITY ░░ -->
  <section class="gather section" aria-labelledby="gather-title">
    <div class="wrap gather-grid">
      <header class="gather-head">
        <p class="label eyebrow" data-reveal>Community</p>
        <Lines id="gather-title" class="display" lines={['A place', 'to *gather.*']} />
        <p class="body-copy" data-reveal style="--d:.1s">Family-owned, veteran- and woman-led, and fueled by our love for community, the outdoors, and artisan craft. For more than eleven years we’ve been serving Southern Indiana and Louisville, one cup at a time.</p>
      </header>

      <div class="g g1 media" data-reveal="mask"><Image src={lounge} alt="The long lounge of the Kølkin coffee shop, with leather sofas, framed art and string lights" widths={[640, 960, 1400]} sizes="(min-width: 1000px) 58vw, 100vw" loading="lazy" /></div>
      <div class="g g2 media" data-reveal="mask" style="--d:.1s"><Image src={counter} alt="Baristas behind the reclaimed-wood Kølkin Coffee counter" widths={[480, 760]} sizes="(min-width: 1000px) 30vw, 60vw" loading="lazy" /></div>
      <div class="g g3 media" data-reveal="mask" style="--d:.2s"><Image src={orderHere} alt="A barista working under warm pendant lights beside an ‘Order Here’ sign" widths={[420, 640]} sizes="(min-width: 1000px) 22vw, 50vw" loading="lazy" /></div>

      <figure class="quote" data-reveal>
        <blockquote>
          <p>“Everyone knows authors survive on coffee… and southern Indiana authors survive on Kolkin Coffee.”</p>
        </blockquote>
        <figcaption><span class="label">Kristy Cambron</span><span class="label label--muted">USA Today bestselling author</span></figcaption>
        <a href="/journal/community-connections-episode-1" class="link">Read Community Connections <Arrow /></a>
      </figure>

      <ul class="facts" role="list">
        <li data-reveal><span class="h2 num">{business.founded}</span><span class="label label--muted">Established</span></li>
        <li data-reveal style="--d:.06s"><span class="h2">Family</span><span class="label label--muted">Owned &amp; operated</span></li>
        <li data-reveal style="--d:.12s"><span class="h2">Café</span><span class="label label--muted">&amp; drive-through</span></li>
        <li data-reveal style="--d:.18s"><span class="h2 num">$75<small>/hr</small></span><span class="label label--muted"><a class="text-link" href="/community#rent">Rent our space</a></span></li>
      </ul>
    </div>
  </section>

  <!-- ░░ 07 WHOLESALE ░░ -->
  <section class="trade section on-roast" aria-labelledby="trade-title">
    <div class="wrap trade-grid">
      <div class="trade-head">
        <p class="label eyebrow" data-reveal>Wholesale</p>
        <Lines id="trade-title" class="display" lines={['Coffee that', 'builds *connection.*']} />
      </div>
      <div class="trade-body">
        <p class="lead" data-reveal>We partner with cafés, offices, restaurants and hospitality businesses that care about what’s in the cup.</p>
        <table class="spec" data-reveal style="--d:.1s">
          <caption class="sr-only">Wholesale formats and pricing</caption>
          <thead><tr><th scope="col">Format</th><th scope="col">Minimum</th><th scope="col">Price</th></tr></thead>
          <tbody>
            <tr><th scope="row">5 lb bag</th><td>2 bags</td><td class="num">$55 / bag</td></tr>
            <tr><th scope="row">Bulk 25 lb</th><td>1 unit</td><td class="num">$275 / unit</td></tr>
            <tr><th scope="row">Private label</th><td>50 lb / mo</td><td class="num">$11 / lb<small>+ $350 setup</small></td></tr>
          </tbody>
        </table>
        <p class="label trade-note" data-reveal>$11 / lb · 1-week lead time · volume pricing over 50 lb / month</p>
        <div class="trade-ctas" data-reveal>
          <a href="/wholesale#apply" class="btn btn--light">Let’s build a partnership <Arrow /></a>
          <a href="/wholesale" class="link">Wholesale details</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ 08 VISIT ░░ -->
  <section class="visit section" aria-labelledby="visit-title">
    <div class="wrap visit-grid">
      <div class="visit-media media" data-reveal="mask">
        <Image src={bar} alt="The espresso bar at the Kølkin coffee shop in New Albany" widths={[640, 960, 1400]} sizes="(min-width: 1000px) 50vw, 100vw" loading="lazy" />
      </div>
      <div class="visit-info">
        <p class="label eyebrow" data-reveal>Visit the shop</p>
        <Lines id="visit-title" class="display" lines={['Your place', 'to *pause.*']} />
        <OpenStatus class="visit-status" />
        <address class="visit-addr lead" data-reveal>{business.address.street}<br />{business.address.city}, Indiana {business.address.postal}</address>
        <dl class="visit-hours" data-reveal>
          {hoursSummary.map((h) => <div><dt>{h.days}</dt><dd class="num">{h.time}</dd></div>)}
        </dl>
        <div class="visit-ctas" data-reveal>
          <a class="btn" href={business.directionsUrl} target="_blank" rel="noopener">Get directions <Arrow /></a>
          <a class="btn btn--ghost" href={business.phoneHref}>Call {business.phoneDisplay}</a>
        </div>
        <p class="visit-more" data-reveal>
          <a href="/menu" class="link">See the café menu</a>
          <a href="/visit#order-ahead" class="link">Order ahead</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initHero, initEddy } from '../scripts/water';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-gl]');
  const poster = document.querySelector<HTMLImageElement>('[data-hero-poster]');
  const eddy = document.querySelector<HTMLElement>('[data-eddy]');
  const eddyCanvas = document.querySelector<HTMLCanvasElement>('[data-eddy-gl]');
  const start = () => {
    if (canvas && poster) initHero(canvas, poster, '/textures/river-mask.jpg');
    if (eddy && eddyCanvas) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { initEddy(eddy, eddyCanvas); io.disconnect(); } }, { rootMargin: '600px' });
      io.observe(eddy);
    }
  };
  // Let the poster image paint first (LCP), then bring the water to life.
  if (document.readyState === 'complete') requestIdleCallback?.(start) ?? setTimeout(start, 1);
  else addEventListener('load', () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 800 }) : setTimeout(start, 200)));
</script>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; background: var(--forest); }
  .hero-media { position: absolute; inset: 0; }
  .motion .hero-media { animation: hero-settle 3.2s var(--ease) both; }
  @keyframes hero-settle { from { transform: scale(1.08); } }
  .hero-media img, .hero-gl { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 44% 50%; }
  @media (min-width: 760px) { .hero-media img { object-position: 50% 50%; } }
  .hero-gl { opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero-gl:global(.is-ready) { opacity: 1; }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 40%, transparent 30%, rgba(8,12,10,.55) 100%),
      linear-gradient(to top, rgba(10,15,12,.82) 0%, rgba(10,15,12,.35) 38%, rgba(10,15,12,0) 62%),
      linear-gradient(to right, rgba(10,15,12,.5), rgba(10,15,12,0) 60%);
  }
  .hero-content { position: relative; z-index: 2; padding-top: calc(var(--header-h) + 8vh); padding-bottom: clamp(88px, 12vh, 140px); }
  .hero-kicker { color: rgba(243,237,226,.8); margin-bottom: 22px; }
  .hero :global(.hero-title) { font-size: clamp(3.5rem, 12vw, 12.5rem); line-height: .86; letter-spacing: -.045em; font-weight: 300; max-width: 12ch; }
  .hero-foot { margin-top: clamp(28px, 4vw, 48px); display: grid; gap: 28px; }
  .hero-sub { color: rgba(243,237,226,.86); max-width: 26ch; }
  .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
  .hero-rail { position: absolute; z-index: 2; left: 0; right: 0; bottom: 22px; display: flex; justify-content: space-between; color: rgba(243,237,226,.62); }
  .scroll-cue { display: inline-flex; align-items: center; gap: 12px; }
  .scroll-cue i { width: 1px; height: 34px; background: rgba(243,237,226,.3); position: relative; overflow: hidden; }
  .scroll-cue i::after { content: ''; position: absolute; left: 0; top: -40%; width: 100%; height: 40%; background: var(--cream); animation: cue 2.4s var(--ease) infinite; }
  @keyframes cue { to { top: 100%; } }
  @media (max-width: 759px) { .hero-rail > span:first-child { display: none; } .hero-rail { justify-content: flex-end; } }
  @media (min-width: 1000px) {
    .hero-foot { grid-template-columns: auto auto; justify-content: start; column-gap: clamp(48px, 7vw, 120px); align-items: end; }
    .hero-content { padding-bottom: clamp(100px, 14vh, 170px); }
  }

  /* NAME */
  .name { background: var(--paper); overflow: hidden; }
  .name-grid { display: grid; gap: 28px; }
  .name-word { font-size: clamp(5rem, 24vw, 22rem); line-height: .8; letter-spacing: -.055em; margin-left: -.04em; }
  .name-def { display: grid; gap: 10px; max-width: 34ch; }
  .name-def .h3 { font-weight: 330; }
  .name-fig { margin-top: 20px; width: 78%; justify-self: end; }
  .name-fig .media { aspect-ratio: 4 / 5; }
  .name-fig figcaption { margin-top: 12px; }
  .name-copy { display: grid; gap: 24px; justify-items: start; margin-top: 12px; }
  .name-trio { display: grid; border-top: 1px solid var(--line); margin-top: 40px; }
  .name-trio li { display: flex; align-items: baseline; gap: 18px; border-bottom: 1px solid var(--line); }
  .name-trio a { flex: 1; font: 300 clamp(2rem, 5vw, 3.6rem)/1.3 var(--serif); font-style: italic; letter-spacing: -.02em; padding: 10px 0; transition: color .4s, padding .6s var(--ease); }
  .name-trio a:hover { color: var(--copper); padding-left: 12px; }
  .name-trio .label { color: var(--copper); min-width: 30px; }
  @media (min-width: 1000px) {
    .name-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 0; }
    .name-eyebrow { grid-column: 1 / 6; }
    .name-word { grid-column: 1 / -1; margin-top: 32px; }
    .name-def { grid-column: 8 / 13; margin-top: -2.2vw; }
    .name-fig { grid-column: 1 / 5; width: 100%; margin-top: 90px; grid-row: 4 / span 2; }
    .name-copy { grid-column: 6 / 12; margin-top: 120px; align-self: start; }
    .name-copy .lead { font-size: clamp(1.5rem, 2.1vw, 2.05rem); line-height: 1.32; }
    .name-trio { grid-column: 6 / 13; margin-top: 64px; grid-template-columns: repeat(3, 1fr); border: 0; }
    .name-trio li { flex-direction: column; gap: 6px; border-bottom: 0; border-top: 1px solid var(--line); padding-top: 14px; }
  }

  /* EDDY */
  .eddy { position: relative; height: 420vh; background: var(--char); }
  .eddy-sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .eddy-gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s; }
  .eddy-gl:global(.is-ready) { opacity: 1; }
  .eddy-fallback { position: absolute; inset: 0; display: none; }
  .eddy:global(.no-gl) .eddy-fallback { display: block; }
  .eddy-fallback img { width: 100%; height: 100%; object-fit: cover; opacity: calc(1 - var(--p, 0) * 1.4); }
  .eddy-ui { position: relative; height: 100%; pointer-events: none; }
  .eddy-ticks { position: absolute; right: var(--gutter); top: 50%; transform: translateY(-50%); display: grid; gap: 22px; }
  .eddy-ticks li { display: flex; align-items: center; gap: 10px; justify-content: flex-end; color: rgba(243,237,226,.35); transition: color .4s; }
  .eddy-ticks li::after { content: ''; width: 18px; height: 1px; background: currentColor; transition: width .6s var(--ease); }
  .eddy-beats { position: absolute; inset: 0; pointer-events: none; }
  .beat { position: absolute; left: 0; right: 0; top: calc(var(--k) * 100vh + 0vh); height: 100vh; display: flex; align-items: center; }
  .beat:first-child { top: 0; }
  .beat-inner { max-width: 640px; pointer-events: auto; text-shadow: 0 2px 30px rgba(0,0,0,.35); }
  .beat-n { color: var(--copper-light); display: block; margin-bottom: 18px; }
  .beat-title { font-size: clamp(3rem, 8vw, 7.4rem); }
  .beat-copy { margin-top: 20px; max-width: 30ch; color: rgba(243,237,226,.86); }
  .beat-cta { margin-top: 30px; }
  .beat:nth-child(even) .beat-inner { margin-left: auto; text-align: right; }
