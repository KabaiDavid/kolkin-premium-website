---
import { Image, getImage } from 'astro:assets';
import type { Product } from '../data/catalog';
import { money } from '../data/catalog';

interface Props { product: Product; compact?: boolean; index?: number; eager?: boolean }
const { product: p, compact = false, index, eager = false } = Astro.props;
const thumb = await getImage({ src: p.bag, width: 160, format: 'webp' });
const v12 = p.variants.find((v) => v.title === '12oz' && v.available) ?? p.variants.find((v) => v.available);
const Tag = compact ? 'h3' : 'h2';
---
<article class={`card ${compact ? 'card--compact' : ''}`} style={`--tint:${p.tint}; --accent:${p.accent}`}>
  <a href={`/products/${p.handle}`} class="card-media" aria-label={`${p.title}, from ${money(p.priceFrom)}`}>
    {index !== undefined && <span class="card-idx label num" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
    <Image src={p.bag} alt="" widths={compact ? [300, 480] : [420, 680, 900]} sizes={compact ? '(min-width: 1000px) 22vw, 46vw' : '(min-width: 1000px) 40vw, 92vw'} loading={eager ? 'eager' : 'lazy'} class="card-bag" />
    <ul class="card-notes" aria-hidden="true">{p.notes.map((n) => <li>{n}</li>)}</ul>
  </a>
  <div class="card-body">
    <Tag class="card-title"><a href={`/products/${p.handle}`}>{p.origin}<em>{p.origin === 'Espresso' ? 'Kølkin Blend' : p.region}</em></a></Tag>
    {!compact && <p class="card-notes-text">{p.notes.join(' · ')}</p>}
    <div class="card-foot">
      <p class="card-price num">From {money(p.priceFrom)}</p>
      {v12 ? (
        <button type="button" class="card-add"
          data-add={JSON.stringify({ variantId: v12.id, handle: p.handle, title: p.title, variantTitle: v12.title, price: v12.price, image: thumb.src })}
          aria-label={`Add ${p.title}, ${v12.title}, ${money(v12.price)} to bag`}>+ {v12.title}</button>
      ) : <span class="label label--muted">Sold out</span>}
    </div>
  </div>
</article>

<style>
  .card { display: grid; gap: 16px; }
  .card-media { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 5; background: var(--tint); overflow: hidden; }
  .card-media :global(.card-bag) { height: 82%; width: auto; filter: drop-shadow(0 26px 28px rgba(20,14,8,.28)); transition: transform 1.1s var(--ease); }
  .card-media:hover :global(.card-bag), .card-media:focus-visible :global(.card-bag) { transform: translateY(-10px) rotate(-1.5deg) scale(1.02); }
  .card-idx { position: absolute; top: 16px; left: 16px; color: color-mix(in srgb, var(--ink) 60%, transparent); }
  .card-notes { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; opacity: 0; transform: translateY(10px); transition: opacity .6s var(--ease), transform .6s var(--ease); }
  .card-notes li { font: 560 .62rem/1 var(--sans); font-stretch: 118%; letter-spacing: .14em; text-transform: uppercase; padding: 8px 10px; background: color-mix(in srgb, var(--paper) 82%, transparent); }
  .card-media:hover .card-notes, .card-media:focus-visible .card-notes { opacity: 1; transform: none; }
  .card-body { display: grid; gap: 8px; }
  .card-title { font: 360 clamp(1.6rem, 2.4vw, 2.3rem)/1.02 var(--serif); letter-spacing: -.02em; }
  .card-title em { display: block; font-style: italic; font-weight: 300; font-size: .58em; color: var(--ink-soft); margin-top: 4px; letter-spacing: 0; }
  .card-title a:hover { color: var(--copper); }
  .card-notes-text { color: var(--ink-soft); font-size: .95rem; }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 4px; }
  .card-price { font-size: .98rem; }
  .card-add {
    min-height: 44px; padding: 0 14px; border: 1px solid var(--line);
    font: 600 var(--fs-label)/1 var(--sans); font-stretch: 118%; letter-spacing: .14em; text-transform: uppercase;
    transition: background .4s var(--ease), color .4s, border-color .4s;
  }
  .card-add:hover { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .card--compact .card-title { font-size: clamp(1.35rem, 1.8vw, 1.75rem); }
  @media (hover: none) { .card-notes { display: none; } }
</style>
