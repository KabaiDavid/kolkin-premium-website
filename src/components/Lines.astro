---
// Splits a headline into masked lines for the "lines" reveal. Pass lines as an array;
// wrap a word in *asterisks* to set it in italic.
interface Props { lines: string[]; as?: string; class?: string; delay?: number; id?: string }
const { lines, as = 'h2', class: cls = '', delay = 0, id } = Astro.props;
const Tag = as as any;
const fmt = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<Tag class={cls} data-reveal="lines" style={`--d:${delay}s`} id={id}>
  {lines.map((l, i) => <span class="ln"><span style={`--i:${i}`} set:html={fmt(l)} /></span>)}
</Tag>
