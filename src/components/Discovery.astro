---
// "Find your current" — editorial index of the coffees with a live stage (desktop)
// and swipeable tinted cards (mobile). Each row is a real link + a real add-to-bag.
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import Arrow from './Arrow.astro';
import { products, money } from '../data/catalog';

const thumbs = await Promise.all(products.map((p) => getImage({ src: p.bag, width: 160, format: 'webp' })));
---
<div class="disc" data-disc>
  <div class="stage" aria-hidden="true" style={`--tint:${products[0].tint}`} data-stage>
    <div class="stage-word" data-stage-word>{products[0].origin}</div>
    {products.map((p, i) => (
      <Image src={p.bag} alt="" widths={[420, 640, 860]} sizes="(min-width: 1000px) 30vw, 1px" class={`stage-bag ${i === 0 ? 'is-on' : ''}`} data-stage-bag={p.handle} loading={i === 0 ? 'lazy' : 'lazy'} />
    ))}
    <div class="stage-notes" data-stage-notes>
      {products[0].notes.map((n) => <span>{n}</span>)}
    </div>
  </div>

  <ol class="rows" role="list">
    {products.map((p, i) => {
      const v12 = p.variants.find((v) => v.title === '12oz') ?? p.variants[0];
      return (
        <li class="row" style={`--tint:${p.tint}; --accent:${p.accent}`} data-row={p.handle} data-origin={p.origin} data-notes={JSON.stringify(p.notes)}>
          <a class="row-link" href={`/products/${p.handle}`} aria-label={`${p.title} — from ${money(p.priceFrom)}`}></a>
          <div class="row-thumb" aria-hidden="true">
            <Image src={p.bag} alt="" widths={[300, 520]} sizes="(min-width: 1000px) 1px, 60vw" loading="lazy" />
          </div>
          <span class="row-num label num">{String(i + 1).padStart(2, '0')}</span>
          <div class="row-main">
            <h3 class="row-title"><span>{p.origin}</span> <em>{p.region}</em></h3>
            <p class="row-notes">{p.notes.join(' · ')}</p>
          </div>
          <dl class="row-meta">
            <div><dt class="sr-only">Roast</dt><dd class="label label--muted">{p.roast} roast</dd></div>
            <div><dt class="sr-only">Price</dt><dd class="row-price num">From {money(p.priceFrom)}</dd></div>
          </dl>
          <div class="row-actions">
            {p.available && v12?.available ? (
              <button type="button" class="btn btn--ghost row-add"
                data-add={JSON.stringify({ variantId: v12.id, handle: p.handle, title: p.title, variantTitle: v12.title, price: v12.price, image: thumbs[i].src })}
                aria-label={`Add ${p.title}, ${v12.title}, ${money(v12.price)} to bag`}>
                Add {v12.title} · {money(v12.price)}
              </button>
            ) : <span class="label label--muted">Sold out</span>}
            <span class="row-go" aria-hidden="true"><Arrow /></span>
          </div>
        </li>
      );
    })}
  </ol>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-disc]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const word = root.querySelector<HTMLElement>('[data-stage-word]')!;
    const notes = root.querySelector<HTMLElement>('[data-stage-notes]')!;
    const bags = root.querySelectorAll<HTMLElement>('[data-stage-bag]');
    let current = '';
    const show = (row: HTMLElement) => {
      const h = row.dataset.row!;
      if (h === current) return;
      current = h;
      stage.style.setProperty('--tint', getComputedStyle(row).getPropertyValue('--tint'));
      stage.style.setProperty('--accent', getComputedStyle(row).getPropertyValue('--accent'));
      bags.forEach((b) => b.classList.toggle('is-on', b.dataset.stageBag === h));
      word.classList.remove('swap'); void word.offsetWidth; word.classList.add('swap');
      word.textContent = row.dataset.origin!;
      notes.replaceChildren(...JSON.parse(row.dataset.notes!).map((n: string, i: number) => {
        const s = document.createElement('span'); s.textContent = n; s.style.setProperty('--i', String(i)); return s;
      }));
      root.querySelectorAll('[data-row]').forEach((r) => r.classList.toggle('is-active', r === row));
    };
    root.querySelectorAll<HTMLElement>('[data-row]').forEach((row, i) => {
      if (i === 0) row.classList.add('is-active');
      row.addEventListener('pointerenter', () => show(row));
      row.addEventListener('focusin', () => show(row));
    });
  }
</script>

<style>
  .disc { position: relative; }
  .stage { display: none; }
  .rows { display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 340px); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gutter) 24px; margin-inline: calc(var(--gutter) * -1); scrollbar-width: none; overscroll-behavior-x: contain; }
  .rows::-webkit-scrollbar { display: none; }
  .row { position: relative; scroll-snap-align: start; background: var(--tint); display: grid; grid-template-rows: auto auto 1fr auto; padding: 18px 18px 20px; gap: 8px; isolation: isolate; }
  .row-link { position: absolute; inset: 0; z-index: 1; }
  .row-link:focus-visible { outline-offset: -4px; }
  .row-thumb { aspect-ratio: 1 / 1.05; display: grid; place-items: center; margin: 0 -18px 4px; }
  .row-thumb img { height: 100%; width: auto; object-fit: contain; filter: drop-shadow(0 18px 24px rgba(20,14,8,.28)); }
  .row-num { color: var(--ink-soft); order: -1; }
  .row-title { font: 360 1.9rem/1 var(--serif); letter-spacing: -.02em; }
  .row-title em { display: block; font-style: italic; font-weight: 300; font-size: 1.15rem; margin-top: 4px; color: var(--ink-soft); }
  .row-notes { font-size: .92rem; color: var(--ink-soft); margin-top: 8px; }
  .row-meta { display: flex; justify-content: space-between; align-items: baseline; margin-top: 10px; }
  .row-price { font: 400 1.15rem var(--serif); }
  .row-actions { display: flex; align-items: center; gap: 12px; margin-top: 10px; position: relative; z-index: 2; }
  .row-add { min-height: 46px; padding: 0 16px; flex: 1; }
  .row-go { display: none; }

  @media (min-width: 1000px) {
    .disc { display: grid; grid-template-columns: 5fr 7fr; gap: var(--gutter); align-items: start; }
    .stage {
      display: block; position: sticky; top: calc(var(--header-h) + 24px); height: calc(100vh - var(--header-h) - 48px); min-height: 520px; max-height: 820px;
      background: var(--tint); transition: background-color 1s var(--ease); overflow: hidden;
    }
    .stage-word {
      position: absolute; left: 0; right: 0; top: 6%; text-align: center;
      font: 300 clamp(5rem, 9vw, 9.5rem)/1 var(--serif); letter-spacing: -.045em; font-style: italic;
      color: color-mix(in srgb, var(--accent, #7A5236) 32%, transparent);
    }
    .stage-word.swap { animation: word-in 1s var(--ease); }
    @keyframes word-in { from { opacity: 0; transform: translateY(24px); filter: blur(6px); } }
    .stage-bag {
      position: absolute; left: 50%; bottom: 10%; height: 70%; width: auto; transform: translate(-50%, 30px) rotate(-3deg); opacity: 0;
      transition: opacity .7s var(--ease), transform 1.1s var(--ease);
      filter: drop-shadow(0 40px 40px rgba(20,14,8,.32));
    }
    .stage-bag.is-on { opacity: 1; transform: translate(-50%, 0) rotate(0deg); }
    .stage-notes { position: absolute; left: 24px; right: 24px; bottom: 22px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
    .stage-notes span {
      font: 560 .7rem/1 var(--sans); font-stretch: 118%; letter-spacing: .14em; text-transform: uppercase;
      padding: 9px 12px; border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); background: color-mix(in srgb, var(--paper) 40%, transparent);
      animation: note-in .8s var(--ease) both; animation-delay: calc(var(--i, 0) * .07s + .15s);
    }
    @keyframes note-in { from { opacity: 0; transform: translateY(10px); } }

    .rows { display: block; overflow: visible; padding: 0; margin: 0; border-top: 1px solid var(--line); }
    .row {
      background: transparent; grid-template-columns: 56px 1fr auto auto; grid-template-rows: auto; align-items: center;
      gap: 24px; padding: 34px 8px; border-bottom: 1px solid var(--line); transition: background-color .6s var(--ease), padding .6s var(--ease);
    }
    .row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--tint); transform: scaleY(0); transform-origin: bottom; transition: transform .7s var(--ease); }
    .row.is-active::before { transform: scaleY(1); }
    .row.is-active { padding-inline: 20px; }
    .row-thumb { display: none; }
    .row-num { order: 0; align-self: start; padding-top: 12px; }
    .row-title { font-size: clamp(2.2rem, 3.4vw, 3.3rem); }
    .row-title span { transition: font-style .3s; }
    .row-title em { display: inline; font-size: .5em; margin: 0 0 0 10px; letter-spacing: 0; }
    .row-meta { flex-direction: column; align-items: flex-end; gap: 6px; margin: 0; text-align: right; }
    .row-actions { margin: 0; }
    .row-add { flex: none; opacity: 0; transform: translateX(8px); transition: opacity .5s var(--ease), transform .5s var(--ease), color .5s var(--ease), border-color .5s var(--ease); }
    .row.is-active .row-add, .row-add:focus-visible { opacity: 1; transform: none; }
    .row-go { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; transition: background .5s var(--ease), color .5s, border-color .5s; }
    .row.is-active .row-go { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  }
  @media (hover: none) and (min-width: 1000px) { .row-add { opacity: 1; transform: none; } }
</style>
